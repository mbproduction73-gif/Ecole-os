# Copiez ce fichier en .env et remplissez UNIQUEMENT sur votre serveur. Ne commitez jamais .env.
# Base de données (SQLite par défaut ; PostgreSQL : postgresql+psycopg://user:pass@host:5432/db)
DATABASE_URL=
TIMEZONE=Europe/Brussels
# Jeton d'accès au tableau de bord (OBLIGATOIRE si le serveur est public)
DASHBOARD_TOKEN=
# 1 = ne pas démarrer le planificateur
DISABLE_SCHEDULER=0

# Shopify Admin API (app personnalisée, scopes read_products,write_products,read_orders,read_inventory)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
# Stripe : clé restreinte en lecture seule recommandée (rk_...)
STRIPE_API_KEY=
# Google Trends (pytrends, sans clé). Mettre 1 pour désactiver.
GOOGLE_TRENDS_DISABLED=0

# --- Intégrations futures (non implémentées : resteront « non connecté ») ---
CJ_API_EMAIL=
CJ_API_KEY=
ZENDROP_API_KEY=
BIGBUY_API_KEY=
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=
META_ADLIB_TOKEN=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
TIKTOK_BUSINESS_TOKEN=
TIKTOK_ADVERTISER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
WOO_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
